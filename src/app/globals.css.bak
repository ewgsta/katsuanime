/* --- MİNİMALİST VE YUMUŞAK DEĞİŞKENLER --- */
:root {
    --bg-base: #0a0a0b;
    --bg-surface: #121214;
    --sidebar-width: 90px;
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.08);
    --text-main: #f4f4f5;
    --text-muted: #a1a1aa;
    --accent: #ffffff;
    /* Yumuşatılmış, göze hoş gelen köşeler */
    --radius-md: 16px;
    --radius-lg: 24px;
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Figtree", sans-serif;
    background-color: var(--bg-base);
    color: var(--text-main);
    line-height: 1.6;
    display: flex;
    /* Sidebar ve İçerik için Flex yapısı */
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

h1,
h2,
h3,
.logo {
    font-family: "Sora", sans-serif;
    letter-spacing: -0.01em;
}

a {
    text-decoration: none;
    color: inherit;
}

/* --- SOL MINIMAL SIDEBAR --- */
.sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-surface);
    border-right: 1px solid var(--glass-border);
    position: fixed;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 0;
    z-index: 1000;
}

/* İzleme sayfasında sidebar'ı gizle */
body:has(.watch-page-wrapper) .sidebar {
    display: none;
}

body:has(.watch-page-wrapper) .main-content {
    margin-left: 0;
}

.sidebar .logo {
    margin-bottom: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.sidebar .logo img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--radius-md);
    background-color: var(--glass-border);
}

.nav-links {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 100%;
    align-items: center;
}

.nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: var(--transition);
}

.nav-item:hover,
.nav-item.active {
    background-color: var(--glass-bg);
    color: var(--accent);
}

/* Basit inline SVG İkonlar */
.nav-item svg {
    width: 22px;
    height: 22px;
    stroke-width: 2;
}

.sidebar-bottom {
    margin-top: auto;
}

.user-profile {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    /* Profil fotoğrafı yuvarlak kalabilir */
    background-color: var(--glass-border);
    overflow: hidden;
    cursor: pointer;
}

.user-profile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* --- ANA İÇERİK ALANI --- */
.main-content {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding-bottom: 50px;
}

/* --- HERO BÖLÜMÜ --- */
.hero {
    position: relative;
    height: 75vh;
    display: flex;
    align-items: flex-end;
    padding: 60px 5%;
    border-bottom-left-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
    margin-bottom: 40px;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
            var(--bg-base) 0%,
            rgba(10, 10, 11, 0.5) 50%,
            transparent 100%);
    z-index: 1;
}

/* Hero bg image container if needed, but handled inline in JS style */

.hero-content {
    position: relative;
    z-index: 10;
    max-width: 700px;
}

.tag {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    color: var(--text-main);
    padding: 6px 16px;
    border-radius: 30px;
    /* Tagler biraz daha yuvarlak durabilir */
    font-size: 13px;
    font-weight: 500;
    display: inline-block;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 16px;
    color: var(--accent);
}

.hero p {
    color: var(--text-muted);
    font-size: 15px;
    margin-bottom: 24px;
    line-height: 1.6;
    max-width: 90%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.btn-group {
    display: flex;
    gap: 16px;
}

.btn-play {
    background: var(--accent);
    color: var(--bg-base);
    padding: 14px 32px;
    border-radius: var(--radius-md);
    /* Yumuşatılmış köşe */
    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
    cursor: pointer;
}

.btn-play:hover {
    opacity: 0.9;
}

.btn-list {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 14px 32px;
    border-radius: var(--radius-md);
    /* Yumuşatılmış köşe */
    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
    backdrop-filter: blur(16px);
    transition: all 0.2s ease;
    cursor: pointer;
}

.btn-list:hover {
    background: rgba(255, 255, 255, 0.08);
}

/* --- İÇERİK GRID BÖLÜMÜ --- */
.section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 5%;
    margin-bottom: 24px;
}

.section-header h2 {
    font-size: 22px;
    font-weight: 600;
}

.section-header a {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.2s;
}

.section-header a:hover {
    color: var(--text-main);
}

.anime-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 24px;
    padding: 0 5%;
    margin-bottom: 60px;
}

.anime-card {
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    /* Yumuşatılmış köşeler */
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.anime-card img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
}

/* Hover efekti sadece kartı çok hafif yukarı kaldırıyor */
.anime-card:hover {
    transform: translateY(-6px);
}

.card-info {
    padding: 16px;
}

.card-title {
    font-family: "Sora", sans-serif;
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 4px;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-meta {
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
}

/* --- RESPONSIVE --- */
@media (max-width: 768px) {
    .sidebar {
        width: 100%;
        height: 70px;
        flex-direction: row;
        justify-content: space-around;
        padding: 0;
        bottom: 0;
        top: auto;
        border-right: none;
        border-top: 1px solid var(--glass-border);
    }

    .sidebar .logo,
    .sidebar-bottom {
        display: none;
    }

    .nav-links {
        flex-direction: row;
        justify-content: space-evenly;
        gap: 0;
    }

    .main-content {
        margin-left: 0;
        padding-bottom: 90px;
    }

    .hero {
        border-radius: 0;
        height: 65vh;
    }

    .hero h1 {
        font-size: 36px;
    }
}