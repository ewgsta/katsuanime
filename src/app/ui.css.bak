/* src/app/ui.css */
/* MODAL */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
}

.modal-container {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    width: 90%;
    max-width: 400px;
    padding: 30px;
    transform: translateY(20px);
    transition: transform 0.3s ease;
    position: relative;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
}

.modal-overlay.open .modal-container {
    transform: translateY(0);
}

.modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 5px;
    border-radius: 50%;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-close:hover {
    background: var(--glass-bg);
    color: var(--text-main);
}

.modal-title {
    font-family: "Sora", sans-serif;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 24px;
    color: var(--text-main);
}

/* FORMS & INPUTS */
.form-group {
    margin-bottom: 20px;
}

.form-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 8px;
}

.form-input {
    width: 100%;
    background: var(--bg-base);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 14px;
    outline: none;
    transition: var(--transition);
}

.form-input:focus {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.02);
}

.btn-primary {
    width: 100%;
    background: var(--accent);
    color: var(--bg-base);
    border: none;
    padding: 14px;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
        opacity 0.2s ease,
        transform 0.1s ease;
}

.btn-primary:hover {
    opacity: 0.9;
}

.btn-primary:active {
    transform: scale(0.98);
}

/* HORIZONTAL CARDS */
.anime-horizontal-card {
    display: flex;
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
    height: 120px;
}

.anime-horizontal-card:hover {
    transform: translateX(6px);
}

.anime-horizontal-card img {
    width: 80px;
    height: 100%;
    object-fit: cover;
    display: block;
}

.horizontal-card-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
}

.horizontal-card-title {
    font-family: "Sora", sans-serif;
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 8px;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.horizontal-card-meta {
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
}

/* CUSTOM SEARCH INPUT */
.search-input {
    font-size: 16px;
}

.search-input::placeholder {
    font-size: 16px;
    color: rgba(161, 161, 170, 0.7);
}

/* CUSTOM FILTER DROPDOWN - REDESIGNED */
.custom-select-wrapper {
    position: relative;
    min-width: 200px;
}

.custom-select-label {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 12px 40px 12px 16px;
    border-radius: 12px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition);
    user-select: none;
}

.custom-select-label:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
}

.custom-select-arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--text-muted);
    transition: transform 0.3s ease;
}

.custom-select-wrapper.open .custom-select-arrow {
    transform: translateY(-50%) rotate(180deg);
}

/* --- Dropdown Panel --- */
.filter-dropdown-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
    padding: 20px;
    z-index: 5000;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    cursor: default;

    /* Desktop: wide two-column layout */
    width: 560px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.custom-select-wrapper.open .filter-dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}

/* Reset All Button */
.filter-reset-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    font-family: inherit;
}

.filter-reset-btn:hover {
    background: rgba(255, 255, 255, 0.08);
}

.filter-reset-btn.active {
    background: var(--accent);
    color: var(--bg-base);
    border-color: var(--accent);
}

/* Columns Layout: side by side on desktop */
.filter-columns {
    display: flex;
    gap: 20px;
}

.filter-col {
    flex: 1;
}

.filter-col-genres {
    flex: 2.5;
    border-right: 1px solid var(--glass-border);
    padding-right: 20px;
}

/* Section Title inside dropdown */
.filter-section-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    padding-left: 2px;
    pointer-events: none;
}

/* Chip grid for items */
.filter-chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

/* Individual chip/tag */
.filter-chip {
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    white-space: nowrap;
    font-family: inherit;
}

.filter-chip:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
}

.filter-chip.selected {
    color: var(--bg-base);
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
}

/* --- Mobile: vertical stacking --- */
@media (max-width: 768px) {
    .filter-dropdown-panel {
        width: calc(100vw - 10%);
        max-height: 60vh;
        overflow-y: auto;
        padding: 16px;
    }

    .filter-columns {
        flex-direction: column;
        gap: 16px;
    }

    .filter-col-genres {
        border-right: none;
        padding-right: 0;
        border-bottom: 1px solid var(--glass-border);
        padding-bottom: 16px;
    }
}

/* TOAST */
.toast-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 10000;
    pointer-events: none;
}

.toast {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 12px 16px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 300px;
    max-width: 450px;
    animation: toast-slide-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: auto;
    position: relative;
    overflow: hidden;
}



.toast-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.toast.success .toast-icon { color: #10b981; }
.toast.error .toast-icon { color: #ef4444; }
.toast.info .toast-icon { color: #3b82f6; }

.toast-message {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
}

.toast-close {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.toast-close:hover {
    background: var(--glass-bg);
    color: var(--text-main);
}

@keyframes toast-slide-in {
    from {
        transform: translateX(20px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

/* DROPDOWN */
.dropdown-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.dropdown-menu {
    position: absolute;
    bottom: 0px;
    left: 55px;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    min-width: 160px;
    padding: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-10px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1001;
}

.dropdown-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
}

.dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 8px;
    transition: var(--transition);
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    font-family: inherit;
}

.dropdown-item:hover {
    background: var(--glass-bg);
    color: var(--text-main);
}

.dropdown-item.danger:hover {
    background: rgba(220, 38, 38, 0.1);
    color: #ef4444;
}

/* HORIZONTAL MODAL */
.modal-horizontal-container {
    display: flex;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    width: 90%;
    max-width: 750px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    transform: translateY(20px);
    transition: transform 0.3s ease;
    position: relative;
    min-height: 400px;
}

.modal-overlay.open .modal-horizontal-container {
    transform: translateY(0);
}

@media (max-width: 600px) {
    .modal-horizontal-container {
        flex-direction: column;
        max-width: 400px;
        min-height: auto;
    }
}

.modal-auth-image {
    flex: 1;
    background: url("https://i.pinimg.com/736x/30/5b/98/305b9842f97f6c8978cc5f0a4583dbc7.jpg") center/cover no-repeat;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 40px;
}

@media (max-width: 600px) {
    .modal-auth-image {
        min-height: 200px;
    }
}

.modal-auth-image::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg-surface) 0%, transparent 100%);
}

@media (min-width: 601px) {
    .modal-auth-image::before {
        background:
            linear-gradient(to right, transparent 0%, var(--bg-surface) 100%),
            linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
    }
}

.modal-auth-overlay-text {
    position: relative;
    z-index: 10;
}

.modal-auth-overlay-text h2 {
    font-family: "Sora", sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 8px;
    line-height: 1.2;
}

.modal-auth-overlay-text p {
    color: var(--text-muted);
    font-size: 14px;
}

.modal-form-section {
    flex: 1;
    padding: 40px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--bg-surface);
}

/* AUTH ANIMATION VIEWS */
.auth-view-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
}

.auth-view {
    width: 100%;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.auth-view.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    position: relative;
}

.auth-view.outgoing {
    opacity: 0;
    transform: translateX(-40px);
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
}

.auth-view.outgoing-right {
    opacity: 0;
    transform: translateX(40px);
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
}

/* ANIME DETAIL PAGE */
.detail-hero {
    position: relative;
    height: 380px;
    background-size: cover;
    background-position: center;
    border-bottom-left-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
    margin-bottom: 40px;
}

.detail-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
            var(--bg-base) 0%,
            rgba(10, 10, 11, 0.6) 100%);
    border-bottom-left-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
}

.detail-container {
    padding: 0 5%;
    display: flex;
    gap: 40px;
    margin-top: -120px;
    position: relative;
    z-index: 10;
}

@media (max-width: 768px) {
    .detail-container {
        flex-direction: column;
        margin-top: -80px;
    }
}

.detail-poster {
    width: 240px;
    flex-shrink: 0;
}

.detail-poster img {
    width: 100%;
    aspect-ratio: 2/3;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--glass-border);
}

@media (max-width: 768px) {
    .detail-poster {
        width: 180px;
        margin: 0 auto;
    }
}

.detail-content {
    flex: 1;
    padding-top: 20px;
}

.detail-title {
    font-size: 42px;
    font-weight: 700;
    font-family: "Sora", sans-serif;
    color: var(--accent);
    line-height: 1.2;
    margin-bottom: 12px;
}

@media (max-width: 768px) {
    .detail-title {
        font-size: 32px;
        text-align: center;
    }
}

.detail-meta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
    align-items: center;
}

@media (max-width: 768px) {
    .detail-meta-group {
        justify-content: center;
    }
}

.detail-meta-item {
    font-size: 14px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
}

.detail-meta-item strong {
    color: var(--text-main);
    font-weight: 600;
}

.detail-synopsis {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 30px;
}

.episodes-section {
    padding: 40px 5% 80px;
}

.episodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
    margin-top: 24px;
}

.episode-card {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    transition: var(--transition);
}

.episode-card:hover {
    background: var(--glass-bg);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.episode-number {
    font-family: "Sora", sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.1);
    min-width: 40px;
    text-align: center;
    transition: var(--transition);
}

.episode-card:hover .episode-number {
    color: var(--accent);
}

.episode-info h4 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.episode-info span {
    font-size: 12px;
    color: var(--text-muted);
}

/* WATCH PAGE STYLES V2 - PROFESSIONAL */
.watch-page-wrapper {
    width: 100%;
    min-height: 100vh;
    background: var(--bg-base);
    color: var(--text-main);
}

.watch-container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 20px 2% 80px;
}

.watch-layout-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 30px;
    align-items: start;
}

@media (max-width: 1100px) {
    .watch-layout-grid {
        grid-template-columns: 1fr;
    }
}

.watch-main-column {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

/* Player Section */
.player-section-professional {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
}

.player-aspect-ratio {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    /* 16:9 */
    background: #000;
}

.player-inner-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.custom-player-root {
    width: 100%;
    height: 100%;
    position: relative;
}

.katsu-video-player {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
    outline: none;
}

/* KATSU PLAYER STYLES */
.katsu-player-container {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.katsu-video-element {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    outline: none;
    z-index: 1;
}

.player-loading-overlay,
.player-error-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    color: var(--text-muted);
}

.katsu-spinner {
    width: 50px;
    height: 50px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: katsu-spin 1s linear infinite;
}

@keyframes katsu-spin {
    to {
        transform: rotate(360deg);
    }
}

.player-error-overlay {
    color: #ef4444;
}

.player-error-overlay p {
    font-weight: 600;
}


/* Customizing Native Player (Limited support, but better than nothing) */
.katsu-video-player::-webkit-media-controls-panel {
    background-image: linear-gradient(transparent, rgba(0, 0, 0, 0.8)) !important;
}

.player-placeholder-professional {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    color: var(--text-muted);
}

.loader-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--glass-border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* Watch Header & Nav */
.watch-header-simple {
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.01);
}

.watch-title-minimal {
    font-family: "Sora", sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 6px;
}

.watch-meta-pills {
    display: flex;
    gap: 10px;
}

.pill-ep,
.pill-type {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.05em;
}

.pill-ep {
    background: var(--accent);
    color: var(--bg-base);
}

.pill-type {
    background: var(--glass-bg);
    color: var(--text-muted);
    border: 1px solid var(--glass-border);
}

.watch-nav-minimal {
    display: flex;
    align-items: center;
    gap: 15px;
    background: var(--bg-base);
    padding: 6px;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
}

.nav-btn-mini {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: var(--text-muted);
    transition: var(--transition);
}

.nav-btn-mini:hover {
    background: var(--glass-bg);
    color: var(--accent);
}

.nav-ep-indicator {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0 5px;
}

/* Details Section */
.watch-details-section {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    padding: 30px;
}

.section-label {
    font-family: "Sora", sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 15px;
    letter-spacing: 0.1em;
}

.description-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 25px;
}

.action-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    font-size: 14px;
    font-weight: 600;
    transition: var(--transition);
}

.action-btn-outline:hover {
    background: var(--glass-bg);
    border-color: rgba(255, 255, 255, 0.2);
}

/* Sidebar V2 */
.watch-sidebar-v2 {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 40px);
    position: sticky;
    top: 20px;
}

.sidebar-header-v2 {
    padding: 24px;
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.sidebar-title-v2 {
    font-family: "Sora", sans-serif;
    font-size: 18px;
    font-weight: 700;
}

.ep-count-v2 {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
}

.episode-scroll-v2 {
    flex: 1;
    overflow-y: auto;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.episode-scroll-v2::-webkit-scrollbar {
    width: 4px;
}

.episode-scroll-v2::-webkit-scrollbar-thumb {
    background: var(--glass-border);
    border-radius: 10px;
}

.ep-item-v2 {
    display: flex;
    gap: 15px;
    padding: 10px;
    border-radius: 12px;
    transition: var(--transition);
    border: 1px solid transparent;
}

.ep-item-v2:hover {
    background: var(--glass-bg);
}

.ep-item-v2.active {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--glass-border);
}

.ep-item-thumb {
    width: 100px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
}

.ep-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
}

.playing-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
}

.ep-item-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.ep-item-num {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-main);
}

.ep-item-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
}
/* EXPLORE PAGE V2 */
.explore-header-v2 {
    padding: 20px 5% 40px;
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.explore-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.view-toggle-group {
    display: flex;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    padding: 4px;
    border-radius: 12px;
    gap: 4px;
}

.view-toggle-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: none;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition);
}

.view-toggle-btn:hover {
    color: var(--text-main);
    background: var(--glass-bg);
}

.view-toggle-btn.active {
    background: var(--accent);
    color: var(--bg-base);
}

/* FILTER V2 - DROPDOWN VERSION */
.filter-dropdown-v2 {
    position: relative;
}

.filter-btn-v2 {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 12px 20px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: var(--transition);
}

.filter-btn-v2:hover, .filter-btn-v2.active {
    background: var(--glass-bg);
    border-color: rgba(255, 255, 255, 0.2);
}

.filter-panel-v2 {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(3, 180px);
    gap: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.filter-panel-v2.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}

@media (max-width: 768px) {
    .filter-panel-v2 {
        grid-template-columns: 1fr;
        width: calc(100vw - 40px);
        right: -20px;
        max-height: 70vh;
        overflow-y: auto;
    }
}

.filter-column-v2 {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.filter-column-header {
    font-family: "Sora", sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--glass-border);
}

.filter-items-scroll {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 250px;
    overflow-y: auto;
    padding-right: 10px;
}

.filter-items-scroll::-webkit-scrollbar {
    width: 4px;
}
.filter-items-scroll::-webkit-scrollbar-track {
    background: transparent;
}
.filter-items-scroll::-webkit-scrollbar-thumb {
    background: var(--glass-border);
    border-radius: 10px;
}

.filter-item-v2 {
    background: none;
    border: none;
    color: var(--text-muted);
    text-align: left;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
}

.filter-item-v2:hover {
    color: var(--text-main);
    background: var(--glass-bg);
    padding-left: 16px;
}

.filter-item-v2.active {
    color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    font-weight: 600;
}

/* SEARCH V2 */
.search-container-v2 {
    position: relative;
    width: 100%;
    max-width: 500px;
}

.search-icon-v2 {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
}

.search-input-v2 {
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 14px 20px 14px 48px;
    color: var(--text-main);
    font-family: inherit;
    font-size: 15px;
    outline: none;
}

/* LIST VIEW */
.anime-list-v2 {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0 5%;
}

.list-card-v2 {
    display: flex;
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 120px;
    transition: var(--transition);
}

.list-card-v2:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateX(8px);
}

.list-card-v2 img {
    width: 85px;
    height: 100%;
    object-fit: cover;
}

.list-card-info {
    padding: 16px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
}

.list-card-title {
    font-family: "Sora", sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.list-card-meta {
    display: flex;
    gap: 24px;
    font-size: 14px;
    color: var(--text-muted);
}

/* PROFILE PAGE - V3 THEME (Based on User Image & Katsuanime aesthetics) */
.profile-page {
    padding-bottom: 100px;
}

.profile-v3-banner {
    width: 100%;
    height: 350px;
    background: url('https://images.unsplash.com/photo-1578632292335-df3abbb0d586?auto=format&fit=crop&q=80&w=2000') center/cover;
    position: relative;
}

.profile-v3-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, var(--bg-base) 100%);
}

.profile-v3-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 280px 1fr 340px;
    gap: 40px;
    position: relative;
    z-index: 10;
    margin-top: -80px;
}

@media (max-width: 1100px) {
    .profile-v3-container {
        grid-template-columns: 1fr;
        margin-top: -40px;
    }
}

/* Left Sidebar */
.profile-v3-sidebar {
    display: flex;
    flex-direction: column;
}

.profile-v3-avatar-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
    margin-bottom: 20px;
}

.profile-v3-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--bg-base);
    background: var(--bg-surface);
    object-fit: cover;
}

.profile-v3-name {
    font-size: 24px;
    font-weight: 800;
    font-family: 'Sora', sans-serif;
    color: var(--text-main);
}

.profile-v3-handle {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 24px;
}

.profile-v3-bio {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-main);
    margin-bottom: 30px;
}

.profile-v3-info-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 30px;
}

.profile-v3-info-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--text-muted);
}

.profile-v3-info-item svg {
    color: var(--text-main);
}

.profile-v3-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.profile-v3-tag {
    padding: 6px 14px;
    background: transparent;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    font-size: 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: var(--transition);
}

.profile-v3-tag:hover {
    background: rgba(255,255,255,0.05);
    color: var(--text-main);
    border-color: rgba(255,255,255,0.3);
}

/* Middle Column - Feed */
.profile-v3-feed-filters {
    display: flex;
    gap: 12px;
    margin-bottom: 40px;
    margin-top: 80px; 
}

@media (max-width: 1100px) {
    .profile-v3-feed-filters {
        margin-top: 20px;
    }
}

.profile-v3-pill {
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(0,0,0,0.2);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition);
}

.profile-v3-pill:hover {
    background: rgba(255,255,255,0.05);
    color: var(--text-main);
}

.profile-v3-pill.active {
    background: rgba(var(--accent-rgb), 0.2);
    color: var(--accent);
    border-color: var(--accent);
}

.profile-v3-post {
    margin-bottom: 40px;
}

.profile-v3-post-title {
    font-size: 22px;
    font-family: 'Sora', sans-serif;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--text-main);
}

.profile-v3-post-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 20px;
}

.profile-v3-post-img {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    object-fit: cover;
}

/* Right Column - Watched / News */
.profile-v3-right-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 80px;
}

@media (max-width: 1100px) {
    .profile-v3-right-col {
        margin-top: 0;
    }
}

.profile-v3-widget {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.profile-v3-widget-header {
    padding: 16px 20px;
    font-size: 16px;
    font-family: 'Sora', sans-serif;
    font-weight: 600;
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    gap: 10px;
}

.profile-v3-widget-list {
    display: flex;
    flex-direction: column;
}

.profile-v3-widget-item {
    display: flex;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--glass-border);
    transition: var(--transition);
}

.profile-v3-widget-item:last-child {
    border-bottom: none;
}

.profile-v3-widget-item:hover {
    background: var(--glass-bg);
}

.profile-v3-widget-item-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-base);
}

.profile-v3-widget-item-poster {
    width: 48px;
    height: 64px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--bg-base);
}

.profile-v3-widget-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.profile-v3-widget-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 4px;
}

.profile-v3-widget-sub {
    font-size: 12px;
    color: var(--text-muted);
}

/* SETTINGS PAGE */
.settings-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 100px;
}

.settings-header {
    margin-bottom: 40px;
}

.settings-header h1 {
    font-size: 32px;
    font-weight: 800;
    font-family: 'Sora', sans-serif;
    color: var(--text-main);
    margin-bottom: 8px;
}

.settings-header p {
    color: var(--text-muted);
}

.settings-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
}

@media (max-width: 900px) {
    .settings-grid {
        grid-template-columns: 1fr;
    }
}

.settings-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: sticky;
    top: 100px;
}

.settings-nav-item {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: var(--transition);
    text-align: left;
    display: flex;
    align-items: center;
    gap: 12px;
}

.settings-nav-item:hover {
    background: rgba(255,255,255,0.05);
    color: var(--text-main);
}

.settings-nav-item.active {
    background: var(--bg-surface);
    border-color: var(--glass-border);
    color: var(--accent);
}

.settings-content {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.settings-card {
    background: var(--bg-surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 30px;
}

.settings-card-title {
    font-size: 20px;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    margin-bottom: 24px;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 10px;
}

.settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-bottom: 1px solid var(--glass-border);
}

.settings-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.settings-row-info {
    flex: 1;
    padding-right: 20px;
}

.settings-row-info b {
    display: block;
    font-size: 15px;
    color: var(--text-main);
    margin-bottom: 4px;
}

.settings-row-info span {
    font-size: 13px;
    color: var(--text-muted);
}

/* Custom Switch styling */
.settings-switch {
    width: 50px;
    height: 26px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 13px;
    position: relative;
    cursor: pointer;
    transition: var(--transition);
}

.settings-switch.toggled {
    background: var(--accent);
    border-color: var(--accent);
}

.settings-switch-knob {
    width: 18px;
    height: 18px;
    background: var(--text-main);
    border-radius: 50%;
    position: absolute;
    top: 3px;
    left: 4px;
    transition: var(--transition);
}

.settings-switch.toggled .settings-switch-knob {
    transform: translateX(24px);
    background: var(--bg-base);
}

.settings-action-btn {
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: var(--transition);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-main);
}

.settings-action-btn:hover {
    background: rgba(255,255,255,0.08);
}

.settings-action-btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-base);
}

.settings-action-btn.primary:hover {
    filter: brightness(1.1);
}

.settings-action-btn.danger {
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.3);
}

.settings-action-btn.danger:hover {
    background: rgba(239, 68, 68, 0.1);
}
